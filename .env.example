# Copy to .env and fill in. Never commit .env.

# Base image for the build. Built on AI Hub build 154, verified on build 109 (the default). Set another IRIS for Health with AI Hub image (2026.3 or later) to use that build.
IRIS_IMAGE=irishealth-community:2027.1.0AI.109.0

# Required for live mode: TriageAgent uses OpenAI (gpt-4o-mini by default)
OPENAI_API_KEY=

# OpenTelemetry collector endpoint (OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=iris-agentic-production
