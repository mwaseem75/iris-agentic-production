# Copy to .env and fill in. Never commit .env.

# Base image for the build. Tested on build 154; set another IRIS for Health with AI Hub image to use that build.
IRIS_IMAGE=irishealth-community:2026.3.0AI.154.0

# Required for live mode: TriageAgent uses OpenAI (gpt-4o-mini by default)
OPENAI_API_KEY=

# OpenTelemetry collector endpoint (OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=iris-agentic-production
