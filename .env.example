# Copy to .env and fill in. Never commit .env.

# LLM provider key (the README must name which one the app expects)
ANTHROPIC_API_KEY=
# Optional second provider for the model comparison
OPENAI_API_KEY=

# replay = no key needed, uses stored agent runs; live = calls the LLM
DEMO_MODE=replay

# Daily token cap for the public demo (0 = no cap)
DAILY_TOKEN_BUDGET=200000

# OpenTelemetry collector endpoint (OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=iris-agentic-production
